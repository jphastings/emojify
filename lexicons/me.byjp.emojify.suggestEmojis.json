{
  "lexicon": 1,
  "id": "me.byjp.emojify.suggestEmojis",
  "defs": {
    "main": {
      "type": "query",
      "description": "Suggest emoji whose meaning best matches a short passage of text.",
      "parameters": {
        "type": "params",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "maxGraphemes": 300,
            "maxLength": 1200,
            "description": "The passage of text to match, up to 300 graphemes. maxLength is in UTF-8 bytes, not graphemes — emoji-laden input can run up to 4 bytes per grapheme."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3,
            "description": "Maximum number of suggestions to return."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["suggestions"],
          "properties": {
            "suggestions": {
              "type": "array",
              "items": { "type": "ref", "ref": "#suggestion" }
            }
          }
        }
      },
      "errors": [
        { "name": "TextTooLong", "description": "text exceeds the 300-grapheme limit." },
        { "name": "NoMatch", "description": "no suggestion cleared the minimum score." }
      ]
    },
    "suggestion": {
      "type": "object",
      "required": ["emoji", "name", "score"],
      "properties": {
        "emoji": { "type": "string", "description": "The suggested emoji." },
        "name": { "type": "string", "description": "The emoji's CLDR label." },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Cosine similarity in basis points (0-1000). Divide by 1000 for the 0..1 float value used internally — this is an integer because the lexicon primitive set has no float type."
        }
      }
    }
  }
}
